{
  "name": "forna-child-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Production child theme for Forna, Bricks Builder, and WooCommerce.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
